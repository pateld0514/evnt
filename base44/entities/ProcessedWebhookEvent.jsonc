{
  "name": "ProcessedWebhookEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Stripe webhook event ID (unique)",
      "unique": true
    },
    "event_type": {
      "type": "string",
      "description": "Type of webhook event"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this event was processed"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking ID if applicable"
    }
  },
  "required": [
    "event_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}